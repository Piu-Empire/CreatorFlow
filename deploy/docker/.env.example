# Copy to .env locally. Never commit real values. Use distinct JWT and OTP keys.
# Keep the DB password free of semicolons/quotes; a random Base64 value works.
CREATORFLOW_DB_PASSWORD=
CREATORFLOW_JWT_KEY=
CREATORFLOW_OTP_KEY=
CREATORFLOW_SMTP_HOST=smtp.gmail.com
CREATORFLOW_SMTP_PORT=587
CREATORFLOW_SMTP_TLS=StartTls
CREATORFLOW_SMTP_FROM=
CREATORFLOW_SMTP_USERNAME=
CREATORFLOW_SMTP_PASSWORD=
