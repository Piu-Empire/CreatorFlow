# Copy to .env.server on the server only. Do not reuse development keys/passwords.
CREATORFLOW_API_IMAGE=
CREATORFLOW_CONNECTION_STRING=
CREATORFLOW_JWT_ISSUER=
CREATORFLOW_JWT_AUDIENCE=
CREATORFLOW_JWT_KEY=
# Optional mail group. Configure all fields for real verification/reset; otherwise mail is unavailable.
CREATORFLOW_OTP_KEY=
CREATORFLOW_SMTP_HOST=
CREATORFLOW_SMTP_PORT=587
CREATORFLOW_SMTP_TLS=StartTls
CREATORFLOW_SMTP_FROM=
CREATORFLOW_SMTP_USERNAME=
CREATORFLOW_SMTP_PASSWORD=
